{
	"compilerOptions": {
		"target": "ES2020",
		"lib": [ "DOM", "DOM.Iterable", "ES2020" ],
		"allowJs": false,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"types": [ "jest" ]
	},
	"include": [ "src", "tests/js", "specs" ]
}
